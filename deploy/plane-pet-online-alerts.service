[Unit]
Description=Plane Pet lifetime online milestone email sender
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=plane-pet
Group=plane-pet
ExecStart=/usr/bin/python3 /opt/plane-pet/gateway/online_alerts.py worker --password-file /run/credentials/plane-pet-online-alerts.service/smtp-password
LoadCredential=smtp-password:/etc/plane-pet/plane-pet-smtp.password
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/plane-pet
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
