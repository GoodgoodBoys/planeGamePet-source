[Unit]
Description=Plane Pet authoritative game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=plane-pet
Group=plane-pet
ExecStart=/opt/plane-pet/bin/plane-pet-server --bind=127.0.0.1 --port=32110 --seconds=180 --invite-seconds=300 --store=/var/lib/plane-pet/server_bindings.db
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/plane-pet
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
